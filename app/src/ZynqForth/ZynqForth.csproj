<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ZynqForth</RootNamespace>
    <AssemblyName>ZynqForth</AssemblyName>
    <AssemblyTitle>ZYNQ-FORTH</AssemblyTitle>
    <!-- the exe's icon (Explorer, taskbar); app/tools/make_icon.py draws it -->
    <ApplicationIcon>ZynqForth.ico</ApplicationIcon>
    <Description>ZYNQ-FORTH: terminal, editor, dictionary and board view for the HF16 Forth on the Arty Z7-20.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZynqForth.Core\ZynqForth.Core.csproj" />
  </ItemGroup>

  <!-- the window's icon (title bar, Alt-Tab) -->
  <ItemGroup>
    <Resource Include="ZynqForth.ico" />
  </ItemGroup>

  <!-- the user manual, opened by the Manual button (tools/manual_pdf.py builds it) -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\docs\Manual.pdf" LogicalName="ZynqForth.Manual.pdf" />
    <!-- MAX1000-FORTH's manual (a copy), opened instead when the board is a MAX1000 -->
    <EmbeddedResource Include="..\..\..\docs\max1000\MAX1000-FORTH-Manual.pdf" LogicalName="ZynqForth.Max1000Manual.pdf" />
  </ItemGroup>

</Project>
